# --- Rust (D-001) ---
/target/
**/target/
**/*.rs.bk
*.pdb

# Cargo.lock IS committed: ADE ships binaries (CLI, bridge), so reproducible
# builds matter more than downstream version flexibility.

# --- disk images: never committed (D-010, Accepted 2026-08-22) ---
# TOSEC Amiga images are copyrighted commercial software and this is a public
# repository. Ignored by extension everywhere, not by location, so a stray copy
# outside disks/ is caught too.
#
# D-010 committed ADE to generating fixtures rather than storing them, so there
# is no whitelist and these rules have no exceptions. A disk image in this
# repository is a mistake by definition. Reversing that needs a DECISIONS entry,
# not a negation line.
*.adf
*.adz
*.hdf
*.hdz
*.dms
*.scp
*.ipf
/disks/

# --- TOSEC datfiles: third-party data, not committed (F-013) ---
# Freely redistributable metadata rather than disk content, but 31 MB of
# someone else's dataset does not belong in this repository any more than the
# images do. Fetched locally; the parser is what ADE owns.
/datfiles/

# --- Qt6 / CMake GUI (Phase 5) ---
/build/
gui/build/
CMakeCache.txt
CMakeFiles/
*.moc
moc_*.cpp
ui_*.h
qrc_*.cpp

# --- Fuzzing (F-001) ---
fuzz/artifacts/
fuzz/coverage/
tests/fuzz/artifacts/

# --- Test fixtures (D-010) ---
# Covered by the repository-wide extension rules above; only `.raw` is extra.
# tests/fixtures/ holds a manifest and documentation, never image data.
tests/fixtures/**/*.raw

# --- Editors / OS ---
.vscode/
.idea/
*.swp
*~
.DS_Store
