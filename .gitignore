# --- Rust (D-001) ---
/target/
**/target/
**/*.rs.bk
*.pdb

# Cargo.lock IS committed: ADE ships binaries (CLI, bridge), so reproducible
# builds matter more than downstream version flexibility.

# --- disk images: never committed (D-010) ---
# TOSEC Amiga images are copyrighted commercial software and this is a public
# repository. Ignored by extension everywhere, not by location, so a stray copy
# outside disks/ is caught too. When D-010 permits specific fixtures, negate
# them explicitly — committing a disk image should be a deliberate act.
*.adf
*.adz
*.hdf
*.hdz
*.dms
*.scp
*.ipf
/disks/

# --- Qt6 / CMake GUI (Phase 5) ---
/build/
gui/build/
CMakeCache.txt
CMakeFiles/
*.moc
moc_*.cpp
ui_*.h
qrc_*.cpp

# --- Fuzzing (F-001) ---
fuzz/artifacts/
fuzz/coverage/
tests/fuzz/artifacts/

# --- Test fixtures: D-010 guard ---
# Fixture provenance is UNDECIDED (D-010). Most TOSEC Amiga images are
# copyrighted commercial software and must not be committed to a public
# repository. These patterns are a tripwire, not a policy — once D-010 lands,
# whitelist the permitted fixtures explicitly with negation rules below.
tests/fixtures/**/*.adf
tests/fixtures/**/*.adz
tests/fixtures/**/*.hdf
tests/fixtures/**/*.hdz
tests/fixtures/**/*.dms
tests/fixtures/**/*.scp
tests/fixtures/**/*.ipf
tests/fixtures/**/*.raw
# Keep directory structure and any manifests/checksums.
!tests/fixtures/**/.gitkeep
!tests/fixtures/**/*.md
!tests/fixtures/**/*.toml
!tests/fixtures/**/*.sha256

# --- Editors / OS ---
.vscode/
.idea/
*.swp
*~
.DS_Store
